<style type="text/css">
  .logo img {
    width: {{ section.settings.logo_width_desktop }}px;
  }

  @media only screen and (max-width: 767px) {
    #mobile-header .logo img {
      width: {{ section.settings.logo_width_mobile }}px;
    }

    #mobile-header .logo > a {
      width: min(calc({{ section.settings.logo_width_mobile }}px + 10px), 58vw);
    }
  }
</style>

{% if template == 'password' or template == 'gift_card' %}

{% comment %} Password/gift card template logo {% endcomment %}
{% if section.settings.logo != blank %}
<h1 class="logo">
  {% capture img_size %}{{ section.settings.logo_width_desktop | times: 2 }}x{% endcapture %}
  {% assign logo_rendered_height = section.settings.logo_width_desktop | divided_by: section.settings.logo.aspect_ratio | round %}
  <img src="{{ section.settings.logo | img_url: img_size }}" alt="{{ section.settings.logo.alt | default: shop.name | escape }}" width="{{ section.settings.logo_width_desktop }}" height="{{ logo_rendered_height }}" />
</h1>
{% else %}
<h1>{{ shop.name }}</h1>
{% endif %}

{% else %}

<div data-section-type="header">
  <div id="pageheader">

    {% capture logo_html %}
    <div class="logo">
      <a href="/" title="{{ shop.name }}">
        {% if section.settings.logo != blank %}
        {% capture img_size %}{{ section.settings.logo_width_desktop | times: 2 }}x{% endcapture %}
        {% assign logo_rendered_height = section.settings.logo_width_desktop | divided_by: section.settings.logo.aspect_ratio | round %}
        <img src="{{ section.settings.logo | img_url: img_size }}" alt="{{ section.settings.logo.alt | default: shop.name | escape }}" width="{{ section.settings.logo_width_desktop }}" height="{{ logo_rendered_height }}" />
        {% else %}
        <span class="logotext">{{ shop.name }}</span>
        {% endif %}
      </a>
    </div><!-- /#logo -->
    {% endcapture %}

    <div id="mobile-header" class="cf">
      <button class="notabutton mobile-nav-toggle"><span></span><span></span><span></span></button>
      {{ logo_html }}
      <a href="/{% if template != 'cart' %}cart{% else %}checkout{% endif %}" class="cart-count {% if section.settings.use_btn_style_cart_link %}button{% endif %}">
        {% include 'svg-cart' %} <span class="beside-svg">({{ cart.item_count }})</span>
      </a>
    </div>

    <div class="logo-area logo-pos-{{ section.settings.logo_pos }} cf">

      {% unless section.settings.logo_pos == 'below' %}<div class="container">{{ logo_html }}</div>{% endunless %}

      <div class="util-area">
        <div class="search-box elegant-input">
          {% if section.settings.header_signup_show %}
          <div class="signup-reveal-area">
            <a class="signup-reveal" href="#">{{ 'layout.header.signup' | t }}</a>
            {% if section.settings.header_signup_show %}{% include 'signup-form' %}{% endif %}
          </div>
          {% endif %}

          <form class="search-form" action="/search" method="get">
            {% include 'svg-search' %}
            <input type="text" name="q" placeholder="{{ 'layout.header.search' | t }}" autocomplete="off"/>
            <input type="submit" value="&rarr;" />
            <input type="hidden" name="type" value="{{ settings.search_type }}" />
          </form>
        </div>

        <div class="utils">
          {% if section.settings.show_social_icons %}
          {% include 'social-icons' %}
          {% endif %}

          <div class="cart-summary">
            <a href="/{% if template != 'cart' %}cart{% else %}checkout{% endif %}" class="cart-count {% if section.settings.use_btn_style_cart_link %}button{% endif %}">
              {{ 'layout.header.cart' | t }} ({{ cart.item_count }})
            </a>

            {% include 'currencies-switcher' %}
          </div>
        </div><!-- /.utils -->
      </div><!-- /.util-area -->

      {% if section.settings.logo_pos == 'below' %}<div class="container">{{ logo_html }}</div>{% endif %}

    </div><!-- /.logo-area -->
  </div><!-- /#pageheader -->

  {% capture social_icons_html %}{% include 'social-icons' %}{% endcapture %}
  {% capture extra_navigation_items %}
  {% if social_icons_html contains '<li>' %}<div class="mobile-social">{{ social_icons_html }}</div>{% endif %}
  
  {% if shop.customer_accounts_enabled %}
  <ul>
    <li class="account-links">
      {% if customer %}
      <span class="your-acct"><a href="/account">{{ 'layout.customer.account' | t }}</a></span>
      <span class="slash">/</span>
      <span class="logout">{{ 'layout.customer.log_out' | t | customer_logout_link }}</span>
      {% else %}
      {% if section.settings.nav_show_reg %}
      <span class="register">{{ 'layout.customer.register' | t | customer_register_link }}</span> <span class="slash">/</span>
      {% endif %}
      <span class="login">{{ 'layout.customer.log_in' | t | customer_login_link }}</span>
      {% endif %}
    </li>
  </ul>
  {% endif %}
  {% endcapture %}

  <div
    id="main-nav"
    class="nav-row nav-active-{{ section.settings.nav_active_style }} {% if section.settings.nav_autoexpand %}autoexpand{% endif %} {% if section.settings.sticky_nav %}fpd-sticky-nav{% endif %}"
    style="--fpd-nav-size: {{ section.settings.nav_font_size }}px; --fpd-nav-weight: {{ section.settings.nav_font_weight }}; --fpd-nav-tracking: 0.0{{ section.settings.nav_letter_spacing }}em;"
  >
    <div class="mobile-features">
      <form class="mobile-search" action="/search" method="get">
        <i></i>
        <input type="text" name="q" placeholder="{{ 'layout.header.search' | t }}"/>
        <button type="submit" class="notabutton">{% include 'svg-search' %}</button>
      </form>
    </div>
    {% include 'main-navigation' with section.settings.menu_linklist %}
    <div class="mobile-currency-switcher">{% include 'currencies-switcher' %}</div>
  </div><!-- /#main-nav -->


  {% if section.settings.head_not_home_only == false or template == 'index' %}

  <div id="store-messages" class="messages-{{ section.blocks.size }}">
    <div class="container cf">
      {% for block in section.blocks %}

      <div class="message message-{{ forloop.index }}" {{ block.shopify_attributes }}>
        {% if block.settings.link_url != blank %}
        <a href="{{ block.settings.link_url }}">
          {% endif %}

          <span class="fpd-message__icon" aria-hidden="true">
            {% if block.settings.icon == 'storefront' %}
              {% render 'icon-storefront' %}
            {% elsif block.settings.icon == 'location' %}
              {% render 'icon-location' %}
            {% elsif block.settings.icon == 'none' %}
            {% else %}
              {% render 'icon-delivery' %}
            {% endif %}
          </span>
          <span class="fpd-message__copy">
            <h6 class="title">{{ block.settings.heading | escape }}</h6>
            <span class="tagline">{{ block.settings.subheading | escape }}</span>
          </span>

          {% if block.settings.link_url != blank %}
        </a>
        {% endif %}

        {% unless forloop.first %}<div class="fluff"></div>{% endunless %}
      </div>

      {% endfor %}
    </div>
  </div><!-- /#store-messages -->

  {% if section.settings.head_not_mob_show %}
  <div id="store-messages-mobile">
    <div class="container">
      {% if section.settings.head_not_mob_url != blank %}
      <a href="{{ section.settings.head_not_mob_url }}">
        {% endif %}
        {{ section.settings.head_not_mob_text | escape }}
        {% if section.settings.head_not_mob_url != blank %}
      </a>
      {% endif %}
    </div>
  </div>
  {% endif %}

  {% endif %}
</div>

{% endif %}

{% if section.settings.sticky_nav %}
<script>
  (function() {
    var nav = document.getElementById('main-nav');
    if (!nav || nav.dataset.fpdStickyReady === 'true') return;

    nav.dataset.fpdStickyReady = 'true';
    var placeholder = document.createElement('div');
    placeholder.className = 'fpd-nav-placeholder';
    placeholder.setAttribute('aria-hidden', 'true');
    nav.parentNode.insertBefore(placeholder, nav);

    var desktopQuery = window.matchMedia('(min-width: 768px)');
    var ticking = false;

    function clearFixedState() {
      nav.classList.remove('is-fixed');
      placeholder.classList.remove('is-active');
      placeholder.style.height = '';
    }

    function updateStickyNav() {
      ticking = false;
      if (!desktopQuery.matches) {
        clearFixedState();
        return;
      }

      var threshold = placeholder.getBoundingClientRect().top + window.pageYOffset;
      var shouldFix = window.pageYOffset > threshold;
      if (shouldFix) {
        placeholder.style.height = nav.offsetHeight + 'px';
        placeholder.classList.add('is-active');
        nav.classList.add('is-fixed');
      } else {
        clearFixedState();
      }
    }

    function requestStickyUpdate() {
      if (ticking) return;
      ticking = true;
      window.requestAnimationFrame(updateStickyNav);
    }

    window.addEventListener('scroll', requestStickyUpdate, { passive: true });
    window.addEventListener('resize', requestStickyUpdate);
    window.addEventListener('load', requestStickyUpdate);
    if (desktopQuery.addEventListener) {
      desktopQuery.addEventListener('change', requestStickyUpdate);
    }
    requestStickyUpdate();
  })();
</script>
{% endif %}


{% schema %}
  {
    "name": "Header",
	"max_blocks": 3,
    "settings": [
      {
        "type": "link_list",
        "id": "menu_linklist",
        "label": "Menu",
		"default": "main-menu"
      },
      {
        "type": "checkbox",
        "id": "use_btn_style_cart_link",
        "label": "Show cart link as button"
      },
      {
        "type": "checkbox",
        "id": "nav_show_reg",
        "label": "Show 'Register' link in main menu",
		"info": "Requires customer accounts to be enabled in Settings > Checkout"
      },
	  {
        "type": "checkbox",
        "id": "show_social_icons",
        "label": "Show social icons",
		"default": true
      },
      {
        "type": "checkbox",
        "id": "nav_autoexpand",
        "label": "Automatically expand navigation to current page"
      },
      {
        "type": "header",
        "content": "Navigation style"
      },
      {
        "type": "checkbox",
        "id": "sticky_nav",
        "label": "Keep navigation visible while scrolling",
        "default": true
      },
      {
        "type": "range",
        "id": "nav_font_size",
        "label": "Desktop menu text size",
        "min": 15,
        "max": 22,
        "step": 1,
        "unit": "px",
        "default": 18
      },
      {
        "type": "select",
        "id": "nav_font_weight",
        "label": "Menu text weight",
        "options": [
          {
            "value": "500",
            "label": "Medium"
          },
          {
            "value": "600",
            "label": "Semibold"
          },
          {
            "value": "700",
            "label": "Bold"
          }
        ],
        "default": "700"
      },
      {
        "type": "range",
        "id": "nav_letter_spacing",
        "label": "Menu letter spacing",
        "min": 0,
        "max": 9,
        "step": 1,
        "default": 2
      },
      {
        "type": "select",
        "id": "nav_active_style",
        "label": "Current page highlight",
        "options": [
          {
            "value": "pill",
            "label": "Filled pill"
          },
          {
            "value": "underline",
            "label": "Underline"
          },
          {
            "value": "outline",
            "label": "Outlined pill"
          }
        ],
        "default": "pill"
      },
      {
        "type": "checkbox",
        "id": "header_signup_show",
        "label": "Show newsletter signup in header",
		"default": true
      },
      {
        "type": "header",
        "content": "Logo"
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Custom logo image",
        "info": "260 x 100px (recommended)"
      },
      {
        "type": "range",
        "id": "logo_width_desktop",
        "label": "Logo width — desktop",
        "min": 180,
        "max": 460,
        "step": 10,
        "unit": "px",
        "default": 320
      },
      {
        "type": "range",
        "id": "logo_width_mobile",
        "label": "Logo width — mobile",
        "min": 110,
        "max": 240,
        "step": 10,
        "unit": "px",
        "default": 170
      },
      {
        "type": "select",
        "id": "logo_pos",
        "label": "Logo position",
        "options": [
          {
            "value": "",
            "label": "Same row as search\/cart"
          },
          {
            "value": "above",
            "label": "Above search\/cart"
          },
          {
            "value": "below",
            "label": "Below search\/cart"
          }
        ]
      },
      {
        "type": "header",
        "content": "Store messages"
      },
      {
        "type": "paragraph",
        "content": "These are displayed under the main menu - great for promotions and notices"
      },
      {
        "type": "checkbox",
        "id": "head_not_home_only",
        "label": "Show only on home page"
      },
      {
        "type": "header",
        "content": "Mobile store message"
      },
      {
        "type": "checkbox",
        "id": "head_not_mob_show",
        "label": "Enable",
        "default": false
      },
      {
        "type": "text",
        "id": "head_not_mob_text",
        "label": "Text"
      },
      {
    	"type": "url",
        "id": "head_not_mob_url",
        "label": "Link URL"
      }
    ],
	"blocks": [
	  {
		"type": "message",
		"name": "Store message",
		"settings": [
          {
            "type": "text",
            "id": "heading",
            "label": "Heading"
          },
          {
            "type": "text",
            "id": "subheading",
            "label": "Subheading"
          },
          {
            "type": "select",
            "id": "icon",
            "label": "Icon",
            "options": [
              {
                "value": "delivery",
                "label": "Delivery truck"
              },
              {
                "value": "storefront",
                "label": "Storefront"
              },
              {
                "value": "location",
                "label": "Location pin"
              },
              {
                "value": "none",
                "label": "No icon"
              }
            ],
            "default": "delivery"
          },
          {
            "type": "url",
            "id": "link_url",
            "label": "Link URL"
          }
		]
	  }
	]
  }
{% endschema %}
